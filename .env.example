# Add these in Netlify: Site configuration -> Environment variables.
# Never put real values in this file.

# Used by the browser (safe to expose; protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by the server function (mark GROQ_API_KEY as a secret)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
GROQ_API_KEY=your-groq-key
GROQ_MODEL=a-model-id-from-console.groq.com/docs/models
